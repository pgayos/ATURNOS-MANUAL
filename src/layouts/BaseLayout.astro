---
import "../styles/global.css";
import { getCollection } from "astro:content";
import SiteNav from "../components/manual/SiteNav.astro";
import { buildSiteNav, activeSiteNavSectionFor } from "../lib/siteNav";

interface Props {
  title?: string;
  description?: string;
  showProfilePicker?: boolean;
  /** id del artículo actual (p. ej. "planificacion/1-1-menu-principal"), para
   *  resaltar y abrir su rama en el menú persistente. Las páginas que no son
   *  un artículo (home, buscar, hub de módulos…) lo omiten. */
  currentId?: string;
}
const {
  title = "Centro de ayuda de aTurnos",
  description = "Aprende a utilizar aTurnos con guías claras y respuestas verificadas.",
  showProfilePicker = true,
  currentId,
} = Astro.props;
const deploymentBranch = import.meta.env.PUBLIC_DEPLOYMENT_BRANCH;
const preventIndexing = Boolean(
  deploymentBranch && deploymentBranch !== "main",
);

// Menú persistente: se construye en cada página (home, buscar, artículos…)
// para que el mismo árbol completo esté siempre visible, se entre por donde
// se entre.
const entries = await getCollection("manual");
const siteNav = buildSiteNav(entries);
const activeSection = activeSiteNavSectionFor(Astro.url.pathname, siteNav);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      // Se ejecuta antes de pintar para evitar el parpadeo claro→oscuro.
      (() => {
        const stored = localStorage.getItem("manual-theme");
        const theme =
          stored ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="description" content={description} />
    {preventIndexing && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/brand/aturnos-symbol.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div
      class="profile-loader"
      id="profile-loader"
      role="status"
      aria-live="polite"
      hidden
    >
      <div class="profile-loader-card">
        <span class="profile-loader-mark" aria-hidden="true">
          <img src="/brand/aturnos-logo.svg" alt="" />
        </span>
        <strong>Adaptando el manual a tu perfil</strong>
        <span>Estamos filtrando los artículos más relevantes.</span>
      </div>
    </div>
    <header class="site-header">
      <nav class="nav" aria-label="Navegación principal">
        <a class="logo" href="/" aria-label="aTurnos · Centro de ayuda">
          <img
            src="/brand/aturnos-logo.svg"
            width="147"
            height="38"
            alt="aTurnos"
          />
          <span class="logo-divider" aria-hidden="true"></span>
          <span>Centro de ayuda</span>
        </a>
        <form
          class="header-search"
          id="header-search"
          action="/buscar/"
          role="search"
          autocomplete="off"
        >
          <span class="header-search-icon" aria-hidden="true">
            ⌕
          </span>
          <label class="sr-only" for="header-search-input">
            Buscar en el manual
          </label>
          <input
            id="header-search-input"
            name="q"
            type="search"
            autocomplete="off"
            aria-expanded="false"
            aria-controls="header-search-suggestions"
            role="combobox"
            aria-autocomplete="list"
            placeholder="Buscar…"
          />
        </form>
        <div
          class="hero-search-suggestions"
          id="header-search-suggestions"
          role="listbox"
          hidden
        >
        </div>
        {showProfilePicker && (
          <select
            class="profile-picker"
            id="profile-picker"
            aria-label="Seleccionar mi perfil"
          >
            <option value="general">Rol usuario</option>
            <option>Trabajador</option>
            <option>Administrador</option>
            <option>RRHH</option>
          </select>
        )}
        <a
          class="header-site-link"
          href="https://www.aturnos.com"
          rel="external"
        >
          <span aria-hidden="true">⌂</span>
          aTurnos.com
        </a>
        <button
          class="theme-toggle"
          id="theme-toggle"
          type="button"
          aria-label="Alternar tema oscuro"
        >
          <svg
            class="theme-toggle-icon theme-toggle-moon"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            aria-hidden="true"
          >
            <path
              d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            ></path>
          </svg>
          <svg
            class="theme-toggle-icon theme-toggle-sun"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            aria-hidden="true"
          >
            <circle
              cx="12"
              cy="12"
              r="3.6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            ></circle>
            <path
              d="M12 2.5v2.6M12 18.9v2.6M4.4 4.4l1.9 1.9M17.7 17.7l1.9 1.9M2.5 12h2.6M18.9 12h2.6M4.4 19.6l1.9-1.9M17.7 6.3l1.9-1.9"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            ></path>
          </svg>
        </button>
      </nav>
    </header>
    <div
      class="header-search-backdrop"
      id="header-search-backdrop"
      aria-hidden="true"
    >
    </div>
    <div class="app-shell">
      <SiteNav
        sections={siteNav}
        activeSection={activeSection}
        currentId={currentId}
      />
      <div class="app-main">
        <slot />
        <footer class="site-footer">
          <div class="footer-inner">
            <img
              class="footer-logo"
              src="/brand/aturnos-logo.svg"
              width="126"
              height="32"
              alt="aTurnos"
            />
            <span>
              Centro de ayuda · Contenido público sujeto a revisión editorial.
            </span>
            <a href="https://aturnos.com/" rel="external">
              Ir a aTurnos.com
            </a>
          </div>
        </footer>
      </div>
    </div>
    <script is:inline>
      const picker = document.querySelector("#profile-picker");
      const profileLoader = document.querySelector("#profile-loader");

      // Jerarquía de roles: cada rol ve lo suyo y lo de los roles inferiores.
      // Trabajador = 1 (solo lo de trabajador), Administrador = 2 (trabajador +
      // administrador), RRHH = 3 (todo). Cualquier otro rol de un artículo
      // (Nóminas, Desarrollador API…) se trata como nivel RRHH.
      const ROLE_RANK = { Trabajador: 1, Administrador: 2, RRHH: 3 };
      const canSee = (profile, rawRoles) => {
        if (!profile || profile === "general") return true;
        const roles = (rawRoles || "").split("|").filter(Boolean);
        if (roles.length === 0) return true;
        const lowest = Math.min(...roles.map((r) => ROLE_RANK[r] ?? 3));
        return lowest <= (ROLE_RANK[profile] ?? 3);
      };

      const applyProfileFilter = (profile) => {
        document.querySelectorAll("[data-profile-card]").forEach((card) => {
          card.hidden = !canSee(profile, card.dataset.profiles);
        });

        document
          .querySelectorAll("[data-module-profile-counts]")
          .forEach((card) => {
            const counts = JSON.parse(card.dataset.moduleProfileCounts || "{}");
            const count =
              profile === "general"
                ? Number(card.dataset.totalCount || 0)
                : Number(counts[profile] || 0);
            card.hidden = profile !== "general" && count === 0;
            const label = card.querySelector("[data-module-count]");
            if (label)
              label.textContent = `${count} ${count === 1 ? "artículo" : "artículos"}`;
          });

        const visibleCards = [
          ...document.querySelectorAll(
            "[data-profile-list] [data-profile-card]:not([hidden])",
          ),
        ];
        document
          .querySelectorAll("[data-profile-visible-count]")
          .forEach((label) => {
            label.textContent = String(visibleCards.length);
          });
        const areas = new Set(
          visibleCards.map((card) => card.dataset.submodule).filter(Boolean),
        );
        document
          .querySelectorAll("[data-profile-area-count]")
          .forEach((label) => {
            label.textContent = String(areas.size);
          });
        document.querySelectorAll("[data-profile-empty]").forEach((message) => {
          message.hidden = visibleCards.length !== 0;
        });

        // Menú lateral: lo que no puede ver el rol se OCULTA (artículos, grupos
        // que se quedan sin nada y categorías enteras).
        const nav = document.querySelector("[data-site-nav]");
        if (nav) {
          nav
            .querySelectorAll("li[hidden]")
            .forEach((li) => (li.hidden = false));
          nav.querySelectorAll("a[data-profiles]").forEach((a) => {
            const ok = canSee(profile, a.dataset.profiles);
            if (a.classList.contains("guide-nav-link")) {
              const li = a.closest("li");
              if (li) li.hidden = !ok;
            } else {
              a.toggleAttribute("data-role-hidden", !ok);
            }
          });
          // ¿El enlace está realmente visible dentro de `scope`?
          const shown = (el, scope) => {
            for (let e = el; e && e !== scope; e = e.parentElement)
              if (e.hidden) return false;
            return !el.hasAttribute("data-role-hidden");
          };
          [...nav.querySelectorAll("li.guide-nav-node")]
            .reverse()
            .forEach((node) => {
              const leaf = [...node.querySelectorAll("a.guide-nav-link")].some(
                (a) => shown(a, node),
              );
              const head = node.querySelector(
                ":scope > a.guide-nav-head-link[data-profiles]",
              );
              const headOk = Boolean(
                head &&
                head.dataset.profiles &&
                !head.hasAttribute("data-role-hidden"),
              );
              node.hidden = !(leaf || headOk);
            });
          const pills = [
            ...nav.querySelectorAll("a.site-nav-pill[data-section]"),
          ];
          pills.forEach((pill) => {
            const panel = nav.querySelector(
              `[data-panel="${pill.dataset.section}"]`,
            );
            if (!panel || !panel.querySelector("[data-profiles]")) {
              pill.hidden = false;
              return;
            }
            const any = [
              ...panel.querySelectorAll(
                "a.guide-nav-link, a.guide-nav-head-link[data-profiles]",
              ),
            ].some((a) => shown(a, panel));
            pill.hidden = !any;
          });
          // Si la categoría activa se quedó sin contenido, pasa a la primera visible.
          const active = pills.find((p) => p.classList.contains("is-active"));
          const first = pills.find((p) => !p.hidden);
          if (active && active.hidden && first) {
            pills.forEach((p) => {
              const on = p === first;
              p.classList.toggle("is-active", on);
              p.setAttribute("aria-selected", String(on));
            });
            nav.querySelectorAll("[data-panel]").forEach((panel) => {
              panel.hidden = panel.dataset.panel !== first.dataset.section;
            });
          }
        }

        // Artículo abierto: si su rol no lo ve, se oculta el contenido y se
        // muestra el aviso.
        const gate = document.querySelector("[data-profile-gate]");
        const notice = document.querySelector("[data-profile-unavailable]");
        if (gate && notice) {
          const ok = canSee(profile, gate.dataset.profiles);
          gate.hidden = !ok;
          notice.hidden = ok;
        }
      };

      const storedProfile = localStorage.getItem("manual-profile") || "general";
      document.documentElement.dataset.profile = storedProfile;
      if (picker) picker.value = storedProfile;
      applyProfileFilter(storedProfile);

      if (picker) {
        picker.addEventListener("change", () => {
          profileLoader.hidden = false;
          profileLoader.dataset.busy = "profile";
          localStorage.setItem("manual-profile", picker.value);
          document.documentElement.dataset.profile = picker.value;
          applyProfileFilter(picker.value);
          window.dispatchEvent(
            new CustomEvent("manual-profile-change", {
              detail: { profile: picker.value },
            }),
          );
          window.setTimeout(() => {
            if (profileLoader.dataset.busy === "profile") {
              delete profileLoader.dataset.busy;
              profileLoader.hidden = true;
            }
          }, 450);
        });
      }

      const themeToggle = document.querySelector("#theme-toggle");
      if (themeToggle) {
        const syncThemeState = () => {
          const dark = document.documentElement.dataset.theme === "dark";
          themeToggle.setAttribute("aria-pressed", String(dark));
        };
        syncThemeState();
        themeToggle.addEventListener("click", () => {
          const root = document.documentElement;
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          root.classList.add("theme-transition");
          root.dataset.theme = next;
          localStorage.setItem("manual-theme", next);
          syncThemeState();
          window.setTimeout(
            () => root.classList.remove("theme-transition"),
            320,
          );
        });
      }
    </script>
    <script>
      import { initSearchWidget } from "../lib/searchWidget.js";
      initSearchWidget({
        form: document.querySelector("#header-search"),
        input: document.querySelector("#header-search-input"),
        suggestions: document.querySelector("#header-search-suggestions"),
        backdrop: document.querySelector("#header-search-backdrop"),
      });
    </script>
  </body>
</html>
