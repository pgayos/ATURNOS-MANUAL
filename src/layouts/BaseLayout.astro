---
import "../styles/global.css";
import { getCollection } from "astro:content";
import SiteNav from "../components/manual/SiteNav.astro";
import { buildSiteNav, activeSiteNavSectionFor } from "../lib/siteNav";

interface Props {
  title?: string;
  description?: string;
  showProfilePicker?: boolean;
  /** id del artículo actual (p. ej. "planificacion/1-1-menu-principal"), para
   *  resaltar y abrir su rama en el menú persistente. Las páginas que no son
   *  un artículo (home, buscar, hub de módulos…) lo omiten. */
  currentId?: string;
}
const {
  title = "Centro de ayuda de aTurnos",
  description = "Aprende a utilizar aTurnos con guías claras y respuestas verificadas.",
  showProfilePicker = false,
  currentId,
} = Astro.props;
const deploymentBranch = import.meta.env.PUBLIC_DEPLOYMENT_BRANCH;
const preventIndexing = Boolean(
  deploymentBranch && deploymentBranch !== "main",
);

// Menú persistente: se construye en cada página (home, buscar, artículos…)
// para que el mismo árbol completo esté siempre visible, se entre por donde
// se entre.
const entries = await getCollection("manual");
const siteNav = buildSiteNav(entries);
const activeSection = activeSiteNavSectionFor(Astro.url.pathname, siteNav);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      // Se ejecuta antes de pintar para evitar el parpadeo claro→oscuro.
      (() => {
        const stored = localStorage.getItem("manual-theme");
        const theme =
          stored ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="description" content={description} />
    {preventIndexing && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/brand/aturnos-symbol.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div
      class="profile-loader"
      id="profile-loader"
      role="status"
      aria-live="polite"
      hidden
    >
      <div class="profile-loader-card">
        <span class="profile-loader-mark" aria-hidden="true"
          ><img src="/brand/aturnos-logo.svg" alt="" /></span
        >
        <strong>Adaptando el manual a tu perfil</strong>
        <span>Estamos filtrando los artículos más relevantes.</span>
      </div>
    </div>
    <header class="site-header">
      <nav class="nav" aria-label="Navegación principal">
        <a class="logo" href="/" aria-label="aTurnos · Centro de ayuda">
          <img
            src="/brand/aturnos-logo.svg"
            width="147"
            height="38"
            alt="aTurnos"
          />
          <span class="logo-divider" aria-hidden="true"></span>
          <span>Centro de ayuda</span>
        </a>
        <form class="header-search" action="/buscar/" role="search">
          <span class="header-search-icon" aria-hidden="true">⌕</span>
          <label class="sr-only" for="header-search-input"
            >Buscar en el manual</label
          >
          <input
            id="header-search-input"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="Buscar…"
          />
        </form>
        {
          showProfilePicker && (
            <select
              class="profile-picker"
              id="profile-picker"
              aria-label="Seleccionar mi perfil"
            >
              <option value="general">Rol usuario</option>
              <option>Trabajador</option>
              <option>Administrador</option>
              <option>RRHH</option>
            </select>
          )
        }
        <a class="header-site-link" href="https://www.aturnos.com" rel="external">
          <span aria-hidden="true">⌂</span>
          aTurnos.com
        </a>
        <button
          class="theme-toggle"
          id="theme-toggle"
          type="button"
          aria-label="Alternar tema oscuro"
        >
          <svg
            class="theme-toggle-icon theme-toggle-moon"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            aria-hidden="true"
          >
            <path
              d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"></path>
          </svg>
          <svg
            class="theme-toggle-icon theme-toggle-sun"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            aria-hidden="true"
          >
            <circle
              cx="12"
              cy="12"
              r="3.6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"></circle>
            <path
              d="M12 2.5v2.6M12 18.9v2.6M4.4 4.4l1.9 1.9M17.7 17.7l1.9 1.9M2.5 12h2.6M18.9 12h2.6M4.4 19.6l1.9-1.9M17.7 6.3l1.9-1.9"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </nav>
    </header>
    <div class="app-shell">
      <SiteNav sections={siteNav} activeSection={activeSection} currentId={currentId} />
      <div class="app-main">
        <slot />
        <footer class="site-footer">
          <div class="footer-inner">
            <img
              class="footer-logo"
              src="/brand/aturnos-logo.svg"
              width="126"
              height="32"
              alt="aTurnos"
            />
            <span
              >Centro de ayuda · Contenido público sujeto a revisión editorial.</span
            >
            <a href="https://aturnos.com/" rel="external">Ir a aTurnos.com</a>
          </div>
        </footer>
      </div>
    </div>
    <script is:inline>
      const picker = document.querySelector("#profile-picker");
      const profileLoader = document.querySelector("#profile-loader");
      if (picker) {
        picker.value = localStorage.getItem("manual-profile") || "general";
        document.documentElement.dataset.profile = picker.value;

        const applyProfileFilter = (profile) => {
          document.querySelectorAll("[data-profile-card]").forEach((card) => {
            const profiles = (card.dataset.profiles || "")
              .split("|")
              .filter(Boolean);
            card.hidden = profile !== "general" && !profiles.includes(profile);
          });

          document
            .querySelectorAll("[data-module-profile-counts]")
            .forEach((card) => {
              const counts = JSON.parse(
                card.dataset.moduleProfileCounts || "{}",
              );
              const count =
                profile === "general"
                  ? Number(card.dataset.totalCount || 0)
                  : Number(counts[profile] || 0);
              card.hidden = profile !== "general" && count === 0;
              const label = card.querySelector("[data-module-count]");
              if (label)
                label.textContent = `${count} ${count === 1 ? "artículo" : "artículos"}`;
            });

          const visibleCards = [
            ...document.querySelectorAll(
              "[data-profile-list] [data-profile-card]:not([hidden])",
            ),
          ];
          document
            .querySelectorAll("[data-profile-visible-count]")
            .forEach((label) => {
              label.textContent = String(visibleCards.length);
            });
          const areas = new Set(
            visibleCards.map((card) => card.dataset.submodule).filter(Boolean),
          );
          document
            .querySelectorAll("[data-profile-area-count]")
            .forEach((label) => {
              label.textContent = String(areas.size);
            });
          document
            .querySelectorAll("[data-profile-empty]")
            .forEach((message) => {
              message.hidden = visibleCards.length !== 0;
            });

          // Sidebar de módulo (guide-nav): los enlaces que no aplican al rol
          // seleccionado quedan visibles pero deshabilitados, no ocultos.
          document
            .querySelectorAll(".guide-nav [data-profiles]")
            .forEach((link) => {
              const profiles = (link.dataset.profiles || "")
                .split("|")
                .filter(Boolean);
              const unavailable =
                profile !== "general" &&
                profiles.length > 0 &&
                !profiles.includes(profile);
              link.classList.toggle("is-role-unavailable", unavailable);
              link.setAttribute("aria-disabled", String(unavailable));
            });

          // Artículo actual: si no aplica al rol seleccionado, se oculta el
          // contenido (y el video) y se muestra el aviso en su lugar.
          const gate = document.querySelector("[data-profile-gate]");
          const unavailableNotice = document.querySelector(
            "[data-profile-unavailable]",
          );
          if (gate && unavailableNotice) {
            const profiles = (gate.dataset.profiles || "")
              .split("|")
              .filter(Boolean);
            const unavailable =
              profile !== "general" &&
              profiles.length > 0 &&
              !profiles.includes(profile);
            gate.hidden = unavailable;
            unavailableNotice.hidden = !unavailable;
          }
        };

        applyProfileFilter(picker.value);
        document.addEventListener("click", (event) => {
          const link = event.target.closest(".is-role-unavailable");
          if (link) event.preventDefault();
        });
        picker.addEventListener("change", () => {
          profileLoader.hidden = false;
          profileLoader.dataset.busy = "profile";
          localStorage.setItem("manual-profile", picker.value);
          document.documentElement.dataset.profile = picker.value;
          applyProfileFilter(picker.value);
          window.dispatchEvent(
            new CustomEvent("manual-profile-change", {
              detail: { profile: picker.value },
            }),
          );
          window.setTimeout(() => {
            if (profileLoader.dataset.busy === "profile") {
              delete profileLoader.dataset.busy;
              profileLoader.hidden = true;
            }
          }, 450);
        });
      }

      const themeToggle = document.querySelector("#theme-toggle");
      if (themeToggle) {
        const syncThemeState = () => {
          const dark = document.documentElement.dataset.theme === "dark";
          themeToggle.setAttribute("aria-pressed", String(dark));
        };
        syncThemeState();
        themeToggle.addEventListener("click", () => {
          const root = document.documentElement;
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          root.classList.add("theme-transition");
          root.dataset.theme = next;
          localStorage.setItem("manual-theme", next);
          syncThemeState();
          window.setTimeout(
            () => root.classList.remove("theme-transition"),
            320,
          );
        });
      }
    </script>
  </body>
</html>
