---
import "../styles/global.css";
import { getCollection } from "astro:content";
import SiteNav from "../components/manual/SiteNav.astro";
import MobileTabBar from "../components/MobileTabBar.astro";
import BaseHead from "../components/layout/BaseHead.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import PageOverlays from "../components/layout/PageOverlays.astro";
import ProfileLoader from "../components/layout/ProfileLoader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import ProfileFilter from "../components/layout/ProfileFilter.astro";
import { buildSiteNav, activeSiteNavSectionFor } from "../lib/siteNav";

interface Props {
  title?: string;
  description?: string;
  showProfilePicker?: boolean;
  /** id del artículo actual (p. ej. "planificacion/1-1-menu-principal"), para
   *  resaltar y abrir su rama en el menú persistente. Las páginas que no son
   *  un artículo (home, buscar, hub de módulos…) lo omiten. */
  currentId?: string;
}
const {
  title = "Centro de ayuda de aTurnos",
  description = "Aprende a utilizar aTurnos con guías claras y respuestas verificadas.",
  showProfilePicker = true,
  currentId,
} = Astro.props;

// Menú persistente: se construye en cada página (home, buscar, artículos…)
// para que el mismo árbol completo esté siempre visible, se entre por donde
// se entre.
const entries = await getCollection("manual");
const siteNav = buildSiteNav(entries);
const activeSection = activeSiteNavSectionFor(Astro.url.pathname, siteNav);
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <ProfileLoader />
    <SiteHeader showProfilePicker={showProfilePicker} />
    <PageOverlays />
    <div class="app-shell">
      <SiteNav
        sections={siteNav}
        activeSection={activeSection}
        currentId={currentId}
      />
      <div class="app-main">
        <slot />
        <SiteFooter />
      </div>
    </div>
    <MobileTabBar currentPath={Astro.url.pathname} />
    <ProfileFilter />
    <script>
      import { initSearchWidget } from "../lib/searchWidget.js";
      initSearchWidget({
        form: document.querySelector("#header-search"),
        input: document.querySelector("#header-search-input"),
        suggestions: document.querySelector("#header-search-suggestions"),
        backdrop: document.querySelector("#header-search-backdrop"),
      });
      initSearchWidget({
        form: document.querySelector("#drawer-search"),
        input: document.querySelector("#drawer-search-input"),
        suggestions: document.querySelector("#drawer-search-suggestions"),
        minWidth: 0,
      });
    </script>
  </body>
</html>
