---
interface QuickLink {
  name: string;
  description: string;
  icon: string;
  badge: string;
  cta: string;
  href?: string;
  external?: boolean;
  disabled?: boolean;
}
interface Props {
  eyebrow: string;
  title: string;
  links: QuickLink[];
}
const { eyebrow, title, links } = Astro.props;
---

<section class="section container">
  <div class="section-heading">
    <div>
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
    </div>
  </div>
  <div class="card-grid">
    {
      links.map((link) =>
        link.disabled ? (
          <div class="card is-disabled" aria-disabled="true">
            <div class="card-top">
              <span class="card-icon">{link.icon}</span>
              <span class="card-badge">{link.badge}</span>
            </div>
            <h3>{link.name}</h3>
            <p>{link.description}</p>
            <span class="card-cta card-soon">Próximamente</span>
          </div>
        ) : (
          <a
            class="card"
            href={link.href}
            rel={link.external ? "external" : undefined}
          >
            <div class="card-top">
              <span class="card-icon">{link.icon}</span>
              <span class="card-badge">
                {link.badge}
                {link.external && (
                  <span class="card-badge-external" aria-hidden="true">
                    ↗
                  </span>
                )}
              </span>
            </div>
            <h3>{link.name}</h3>
            <p>{link.description}</p>
            <span class="card-cta">
              {link.cta}
              <span class="card-cta-arrow" aria-hidden="true">
                →
              </span>
            </span>
          </a>
        ),
      )
    }
  </div>
</section>
