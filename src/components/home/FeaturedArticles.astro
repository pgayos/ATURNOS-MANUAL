---
import type { CollectionEntry } from "astro:content";

interface Props {
  eyebrow: string;
  title: string;
  articles: CollectionEntry<"manual">[];
}

const { eyebrow, title, articles } = Astro.props;
---

{
  articles.length > 0 && (
    <section class="section container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">{eyebrow}</span>
          <h2>{title}</h2>
        </div>
      </div>
      <div class="card-grid">
        {articles.map((a) => (
          <a
            class="card"
            data-profile-card
            data-profiles={a.data.audience.map((item) => item.role).join("|")}
            href={`/manual/${a.id}/`}
          >
            <span class="badge">{a.data.contentType}</span>
            <h3>{a.data.title}</h3>
            <p>{a.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )
}
