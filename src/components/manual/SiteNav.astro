---
// Menú persistente de todo el sitio: arriba las categorías (los mismos
// accesos de la home), debajo el árbol de la categoría seleccionada. Vive en
// BaseLayout, así que aparece en cualquier página, no solo en los artículos.
// En móvil es un panel lateral: lo abre la hamburguesa de la cabecera y lo
// cierran la X, el fondo oscuro o Escape (script inline tras el <nav>).
import GuideNavTree from "./GuideNavTree.astro";
import { guideNavContains, type GuideNav } from "../../lib/guideNav";
import type { SiteNavSection, SiteNavSectionId } from "../../lib/siteNav";
import SoporteCard from "../SoporteCard.astro";
import CopyComponent from "../CopyComponent.astro";
import PendingBadge from "./PendingBadge.astro";

interface Props {
  sections: SiteNavSection[];
  activeSection: SiteNavSectionId | null;
  currentId?: string;
}

const { sections, activeSection, currentId } = Astro.props;

const chevronSvg =
  '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
// Flecha de "enlace externo" (sale del sitio, no cambia el árbol de abajo).
const externalLinkSvg =
  '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 4h5.5v5.5M12 4 4 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

<nav
  class="site-nav is-booting"
  id="site-nav"
  data-site-nav
  aria-label="Navegación del manual"
>
  <div class="site-nav-mobile-header">
    <span class="site-nav-mobile-title">aTurnosDocs</span>
    <button
      class="site-nav-close"
      id="site-nav-close"
      type="button"
      aria-label="Cerrar menú"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          d="M6 6l12 12M18 6L6 18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>
  <form
    class="site-nav-mobile-search"
    id="drawer-search"
    action="/buscar/"
    role="search"
    autocomplete="off"
  >
    <span class="header-search-icon" aria-hidden="true">
      ⌕
    </span>
    <label class="sr-only" for="drawer-search-input">
      Buscar en el manual
    </label>
    <input
      id="drawer-search-input"
      name="q"
      type="search"
      autocomplete="off"
      aria-expanded="false"
      aria-controls="drawer-search-suggestions"
      role="combobox"
      aria-autocomplete="list"
      placeholder="Buscar…"
    />
  </form>
  <div class="site-nav-scroll">
    <div
      class="site-nav-pills"
      role="tablist"
      aria-label="Secciones del manual"
    >
      {sections.map((section) => {
        if (section.kind === "disabled") {
          return (
            <span class="site-nav-pill is-disabled" aria-disabled="true">
              <span class="site-nav-pill-icon" aria-hidden="true">
                {section.icon}
              </span>
              {section.label}
              <span class="site-nav-pill-soon">Próximamente</span>
            </span>
          );
        }
        if (section.kind === "external") {
          return (
            <a
              class="site-nav-pill"
              href={section.href}
              target="_blank"
              rel="external"
            >
              <span class="site-nav-pill-icon" aria-hidden="true">
                {section.icon}
              </span>
              {section.label}
              <span
                class="site-nav-pill-external"
                aria-hidden="true"
                set:html={externalLinkSvg}
              />
            </a>
          );
        }
        const isActive = section.id === activeSection;
        // Glosario navega directo a su página (buscador + filtros): toda la
        // fila es un único <a>, sin un botón aparte al lado — el panel A-Z
        // sigue apareciendo igual una vez ahí, vía el mismo <BaseLayout>.
        // Los demás pills solo cambian de panel (interceptados más abajo).
        if (section.kind === "glossary") {
          return (
            <a
              class:list={["site-nav-pill", { "is-active": isActive }]}
              href={section.href}
              aria-current={isActive ? "page" : undefined}
            >
              <span class="site-nav-pill-icon" aria-hidden="true">
                {section.icon}
              </span>
              {section.label}
              <span
                class="site-nav-pill-arrow"
                aria-hidden="true"
                set:html={chevronSvg}
              />
            </a>
          );
        }
        return (
          <a
            class:list={["site-nav-pill", { "is-active": isActive }]}
            href={section.href}
            data-section={section.id}
            role="tab"
            aria-selected={isActive ? "true" : "false"}
          >
            <span class="site-nav-pill-icon" aria-hidden="true">
              {section.icon}
            </span>
            {section.label}
          </a>
        );
      })}
    </div>

    <div class="site-nav-panels">
      {sections.map((section) => {
        if (section.kind === "disabled" || section.kind === "external")
          return null;
        const isActive = section.id === activeSection;
        return (
          <div
            class="site-nav-panel"
            data-panel={section.id}
            hidden={!isActive}
          >
            {section.kind === "guide" && (
              <GuideNavTree
                groups={section.nav.groups}
                currentId={currentId}
                openFirstIfNoMatch={isActive}
              />
            )}
            {section.kind === "directory" && (
              <ul class="guide-nav-list">
                {section.modules.map((moduleNav: GuideNav) => {
                  const open = guideNavContains(moduleNav, currentId);
                  return (
                    <li class:list={["guide-nav-node", { open }]} data-node>
                      <a
                        class:list={[
                          "guide-nav-head-link",
                          { active: moduleNav.firstArticleId === currentId },
                        ]}
                        href={`/manual/${moduleNav.firstArticleId}/`}
                      >
                        <span class="guide-nav-head-text">
                          {moduleNav.moduleName}
                        </span>
                      </a>
                      <button
                        type="button"
                        class="guide-nav-toggle"
                        aria-expanded={open ? "true" : "false"}
                        aria-label={`Mostrar u ocultar ${moduleNav.moduleName}`}
                      >
                        <span
                          class="guide-nav-toggle-icon"
                          aria-hidden="true"
                          set:html={chevronSvg}
                        />
                      </button>
                      <GuideNavTree
                        groups={moduleNav.groups}
                        currentId={currentId}
                        wrapperClass="guide-nav-sublist"
                      />
                    </li>
                  );
                })}
              </ul>
            )}
            {section.kind === "glossary" && (
              <ul class="guide-nav-sublist site-nav-glossary-list">
                {section.terms.map((term) => (
                  <li>
                    <a
                      class:list={[
                        "guide-nav-link",
                        { active: term.id === currentId },
                      ]}
                      href={term.href}
                      aria-current={term.id === currentId ? "page" : undefined}
                    >
                      {term.title}
                      {term.pending && <PendingBadge />}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })}
    </div>
  </div>
  <!-- <SoporteCard /> -->
  <CopyComponent />
</nav>

<script is:inline>
  const navMenuToggle = document.querySelector("#nav-menu-toggle");
  const siteNavEl = document.querySelector("#site-nav");
  const siteNavBackdrop = document.querySelector("#site-nav-backdrop");
  const siteNavClose = document.querySelector("#site-nav-close");

  const openSiteNav = () => {
    siteNavEl?.classList.add("is-open");
    siteNavBackdrop?.classList.add("is-active");
    navMenuToggle?.setAttribute("aria-expanded", "true");
  };
  const closeSiteNav = () => {
    siteNavEl?.classList.remove("is-open");
    siteNavBackdrop?.classList.remove("is-active");
    navMenuToggle?.setAttribute("aria-expanded", "false");
  };

  navMenuToggle?.addEventListener("click", () => {
    if (siteNavEl?.classList.contains("is-open")) closeSiteNav();
    else openSiteNav();
  });
  siteNavBackdrop?.addEventListener("click", closeSiteNav);
  siteNavClose?.addEventListener("click", closeSiteNav);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeSiteNav();
  });
  window.addEventListener("resize", () => {
    if (window.innerWidth > 980) closeSiteNav();
  });

  // Cada artículo es una página nueva y el menú se vuelve a pintar: se guarda
  // el scroll del árbol al salir y se restaura aquí, antes del primer pintado,
  // para que el menú se quede donde estaba en vez de saltar.
  (() => {
    const scrollBox = siteNavEl?.querySelector(".site-nav-scroll");
    if (!scrollBox) return;
    const KEY = "site-nav-scroll";
    const activePanel = () =>
      siteNavEl.querySelector("[data-panel]:not([hidden])")?.dataset.panel ??
      "";
    try {
      const saved = JSON.parse(sessionStorage.getItem(KEY) ?? "null");
      if (saved && saved.panel === activePanel()) {
        scrollBox.scrollTop = saved.top;
      }
    } catch {}
    // Si el artículo actual queda fuera de la vista (p. ej. se llegó desde
    // otra categoría o desde la home), se centra sin animación.
    const current = siteNavEl.querySelector(
      "[data-panel]:not([hidden]) .active",
    );
    if (current) {
      const box = scrollBox.getBoundingClientRect();
      const r = current.getBoundingClientRect();
      if (r.top < box.top || r.bottom > box.bottom) {
        scrollBox.scrollTop +=
          r.top - box.top - (box.height - r.height) / 2;
      }
    }
    window.addEventListener("pagehide", () => {
      try {
        sessionStorage.setItem(
          KEY,
          JSON.stringify({ panel: activePanel(), top: scrollBox.scrollTop }),
        );
      } catch {}
    });
    // Las animaciones del menú solo para lo que hace el usuario, no al cargar.
    requestAnimationFrame(() =>
      requestAnimationFrame(() => siteNavEl.classList.remove("is-booting")),
    );
  })();
</script>

<script>
  const nav = document.querySelector<HTMLElement>("[data-site-nav]");
  if (nav) {
    // --- Selector de categoría (pills): cambia qué panel se ve, sin recargar
    // la página (todos los árboles ya están en el DOM). ---
    const pillsRow = nav.querySelector<HTMLElement>(".site-nav-pills");
    const pills = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>("[data-section]"),
    );
    const panels = Array.from(
      nav.querySelectorAll<HTMLElement>("[data-panel]"),
    );
    pillsRow?.addEventListener("click", (event) => {
      const pill = (event.target as HTMLElement).closest<HTMLAnchorElement>(
        "[data-section]",
      );
      if (!pill) return;
      event.preventDefault();
      const id = pill.dataset.section;
      const alreadyActive = pill.classList.contains("is-active");
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== id;
      });
      pills.forEach((p) => {
        const active = p === pill;
        p.classList.toggle("is-active", active);
        p.setAttribute("aria-selected", String(active));
      });
      const panel = panels.find((p) => p.dataset.panel === id);
      if (panel && !alreadyActive) revealPanel(panel);
    });

    // Animación de entrada del panel recién mostrado y, si su inicio queda
    // fuera de la vista (pantallas pequeñas), scroll suave hasta él para que
    // se note que el menú se ha desplegado.
    const scrollBox = nav.querySelector<HTMLElement>(".site-nav-scroll");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const revealPanel = (panel: HTMLElement) => {
      panel
        .querySelectorAll<HTMLElement>(":scope > ul > li")
        .forEach((item, index) => {
          item.style.setProperty("--i", String(Math.min(index, 12)));
        });
      panel.classList.remove("is-entering");
      void panel.offsetWidth; // reinicia la animación si ya estaba aplicada
      panel.classList.add("is-entering");
      window.setTimeout(() => panel.classList.remove("is-entering"), 900);

      if (!scrollBox) return;
      const box = scrollBox.getBoundingClientRect();
      const top = panel.getBoundingClientRect().top;
      // Hace falta scroll si quedan menos de ~120px del panel a la vista.
      if (top > box.bottom - 120) {
        scrollBox.scrollTo({
          top: scrollBox.scrollTop + (top - box.top) - 12,
          behavior: reduceMotion.matches ? "auto" : "smooth",
        });
      }
    };

    // --- Acordeón de cada árbol: al abrir una sección se cierran las demás
    // dentro del mismo panel (a cualquier nivel), manteniendo abiertos los
    // antecesores de la que se acaba de abrir. ---
    const setOpen = (node: HTMLElement, open: boolean) => {
      node.classList.toggle("open", open);
      // El control que despliega es el header <button> (sin portada) o, si el
      // header es un <a> con portada, el botón de flecha que va a su lado.
      node
        .querySelectorAll<HTMLElement>(
          ":scope > button.guide-nav-head-link, :scope > button.guide-nav-toggle",
        )
        .forEach((control) =>
          control.setAttribute("aria-expanded", String(open)),
        );
    };
    const ancestors = (node: HTMLElement) => {
      const chain: HTMLElement[] = [];
      let parent =
        node.parentElement?.closest<HTMLElement>("[data-node]") ?? null;
      while (parent) {
        chain.push(parent);
        parent =
          parent.parentElement?.closest<HTMLElement>("[data-node]") ?? null;
      }
      return chain;
    };

    nav.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      // Sin portada, la fila entera es un <button> que despliega/colapsa. Con
      // portada, el texto es un <a> que navega y la flecha es un <button>
      // aparte (.guide-nav-toggle) que despliega/colapsa.
      const trigger = target.closest<HTMLElement>(
        "button.guide-nav-head-link, button.guide-nav-toggle",
      );
      if (!trigger || !nav.contains(trigger)) return;
      const node = trigger.closest<HTMLElement>("[data-node]");
      if (!node) return;
      // El acordeón se limita al panel de la categoría activa; los demás
      // paneles están ocultos y su estado no importa hasta que se muestren.
      const scope = trigger.closest<HTMLElement>("[data-panel]") ?? nav;
      const nodes = Array.from(
        scope.querySelectorAll<HTMLElement>("[data-node]"),
      );

      const willOpen = !node.classList.contains("open");
      if (willOpen) {
        const keep = new Set<HTMLElement>([node, ...ancestors(node)]);
        nodes.forEach((other) => {
          if (!keep.has(other)) setOpen(other, false);
        });
        ancestors(node).forEach((a) => setOpen(a, true));
      }
      setOpen(node, willOpen);
    });
  }
</script>
