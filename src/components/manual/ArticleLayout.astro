---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Video from "./Video.astro";
import { getCollection } from "astro:content";
import { slugify } from "../../lib/slug";
import {
  isGuideModule,
  isFlattenedSubmodule,
  buildGuideNav,
  topLevelModuleSlugOf,
  routeIdOf,
} from "../../lib/guideNav";
import type { CollectionEntry } from "astro:content";
interface Props {
  entry: CollectionEntry<"manual">;
  headings: { depth: number; slug: string; text: string }[];
}
const { entry, headings } = Astro.props;
const d = entry.data;
// El módulo "contenedor" es el primer segmento de la ruta, no "todo menos el
// último": un artículo en app-movil/<módulo-web>/archivo.md pertenece al
// contenedor "app-movil" aunque tenga un segmento extra de carpeta.
const moduleSlug = topLevelModuleSlugOf(entry.id);
// Glosario no tiene páginas de submódulo/subtopic (es un listado único A-Z), así
// que su breadcrumb y eyebrow no muestran la letra usada solo para agrupar.
const isGlossary = d.module === "Glosario";

// "Conceptos": cada relatedTerms (de cualquier artículo, no solo del
// glosario) se linkea al término del glosario cuyo título coincide
// (comparando por slug, sin tildes/mayúsculas); si no hay un término con ese
// nombre, se muestra como texto plano.
const relatedGlossaryTerms = d.relatedTerms.length
  ? await (async () => {
      const glossaryEntries = await getCollection(
        "manual",
        (e) => e.data.module === "Glosario",
      );
      const bySlug = new Map(
        glossaryEntries.map((e) => [slugify(e.data.title), e]),
      );
      return d.relatedTerms.map((term) => {
        const match = bySlug.get(slugify(term));
        return { term, href: match ? `/manual/${routeIdOf(match.id)}/` : null };
      });
    })()
  : [];
const reviewed = d.governance.reviewedAt
  ? d.governance.reviewedAt.toLocaleDateString("es-ES")
  : "Pendiente de revisión";

// Módulos "guía" (p. ej. "Empezar en aTurnos"): el lateral izquierdo muestra el
// índice completo del módulo, agrupado por submódulo y tema, en acordeón, con la
// sección del artículo actual abierta.
const isGuide = isGuideModule(moduleSlug);
const guideNav = isGuide
  ? buildGuideNav(await getCollection("manual"), moduleSlug)
  : null;
const currentId = routeIdOf(entry.id);

// En un módulo "guía" con submódulo aplanado, el tema hace de submódulo: el nivel
// del submódulo envoltorio no se muestra en breadcrumb ni en el eyebrow.
const isFlattened = isGuide && isFlattenedSubmodule(moduleSlug, d.submodule);
// Artículo de portada del módulo guía (la "Introducción"): breadcrumb y eyebrow
// se quedan solo con el nombre del módulo.
const isGuideOverview = Boolean(
  guideNav && guideNav.firstArticleId === currentId,
);
const eyebrowSection = isFlattened ? d.subtopic || null : d.submodule;
const eyebrowText =
  isGlossary || isGuideOverview || !eyebrowSection
    ? d.module
    : `${d.module} · ${eyebrowSection}`;
const pageHeadings = headings.filter((h) => h.depth === 2);

// El selector de rol filtra contenido real en Documentación y App Móvil
// (cualquier módulo guía salvo "Empezar en aTurnos", que es contenido de
// implantación igual para todos los roles).
const showProfilePicker = true;
const articleAudience = d.audience.map((a) => a.role).join("|");
---

<BaseLayout
  title={`${d.title} · aTurnos`}
  description={d.description}
  showProfilePicker={showProfilePicker}
  currentId={currentId}
>
  <div class="container breadcrumbs">
    <a href="/">Inicio</a> /{" "}
    {isGlossary ? (
      d.module
    ) : isGuideOverview ? (
      d.module
    ) : (
      // Todo módulo (salvo Glosario) es un módulo "guía": no hay página propia
      // de submódulo/tema a la que enlazar, así que solo el módulo es
      // clickable (redirige al primer artículo); submódulo/tema quedan como
      // texto de ubicación, no como links.
      <>
        <a href={`/manual/${moduleSlug}/`}>{d.module}</a>
        {isFlattened ? (
          d.subtopic && <> / {d.subtopic}</>
        ) : (
          <>
            {" "}
            / {d.submodule}
            {d.subtopic && <> / {d.subtopic}</>}
          </>
        )}
      </>
    )}
  </div>
  <main class="container article-shell">
    <article data-pagefind-body>
      <header class="article-header">
        <span class="eyebrow">{eyebrowText}</span>
        <h1>{d.title}</h1>
        <p class="lead">{d.description}</p>
        {isGlossary && d.synonyms.length > 0 && (
          <div class="synonyms">
            <h4>Sinónimos:</h4>
            <p>{d.synonyms.join(", ")}</p>
          </div>
        )}

        {!isGlossary && (
          <div class="badges">
            {d.audience.map((a) => (
              <span
                class="badge"
                data-role={a.role}
                data-pagefind-filter={`profile:${a.role}`}
              >
                {a.role}
              </span>
            ))}
          </div>
        )}
        <div class="article-meta">
          <span>◷ Tiempo de lectura: {d.readingTime} min</span>
          <!-- <span
            >✓ Estado: {d.governance.status}</span
          > -->
          <span>↻ Última Actualización: {reviewed}</span>
        </div>
      </header>
      <div
        class="article-content"
        data-profile-gate
        data-profiles={articleAudience}
      >
        {d.video && <Video src={d.video} title={d.title} />}
        <div class="article-body">
          <slot />
        </div>
      </div>
      <p class="profile-unavailable" data-profile-unavailable hidden>
        Lo sentimos, el contenido no está disponible para tu rol seleccionado.
      </p>
      <!-- <div class="feedback">
        <strong>¿Te ha resultado útil este artículo?</strong><div>
          <button type="button">Sí</button>
          <button type="button">No</button>
        </div>
      </div> -->
    </article>
    <aside class="right-panel">
      <nav class="panel-index mini-card" aria-label="Índice del artículo">
        <h3>En esta página</h3>
        {pageHeadings.length > 0 ? (
          pageHeadings.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)
        ) : (
          <span class="panel-index-empty">Sin secciones</span>
        )}

        {relatedGlossaryTerms.length > 0 && (
          <>
            <strong>Conceptos</strong>
            {relatedGlossaryTerms.map(({ term, href }) =>
              href ? (
                <a class="panel-index-concept" href={href}>
                  {term}
                </a>
              ) : (
                <span class="panel-index-concept">{term}</span>
              ),
            )}
          </>
        )}
      </nav>
      <!-- <div class="mini-card ai-box">
        <h3>Autor</h3>
        <p>
          Obtén una respuesta basada únicamente en contenido aprobado y con
          citas.
        </p>
        <a class="button" href="/asistente/">
          Abrir asistente
        </a>
      </div> -->
      <!-- <div class="mini-card">
        <h3>Para tu perfil</h3><p>
          Selecciona tu perfil en la cabecera para destacar requisitos y pasos
          relevantes.
        </p>
      </div> -->
      <div class="mini-card ai-box">
        <h3>Autor</h3>
        <p>{d.governance.owner}</p>
        <a class="button" href="/asistente/">
          Conoce al autor
        </a>
      </div>
      <!-- <div class="mini-card">
        <h3>¿Mas dudas?</h3>
        <a class="card-cta" target="_blank" href="https://www.aturnos.com">
          Contacta con Soporte
        </a>
      </div> -->
    </aside>
  </main>
</BaseLayout>
