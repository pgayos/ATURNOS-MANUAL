---
// Contenido común del <head>: metadatos, tema inicial, favicon y fuentes.
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  /** Navegación sin recarga (solo artículos): la cabecera y el menú lateral
   *  se quedan fijos y solo cambia el contenido. Ver BaseLayout. */
  clientRouter?: boolean;
}
const { title, description, clientRouter = false } = Astro.props;

// Fuera de producción (main) no se indexa: evita que Google publique ramas de prueba.
const deploymentBranch = import.meta.env.PUBLIC_DEPLOYMENT_BRANCH;
const preventIndexing = Boolean(
  deploymentBranch && deploymentBranch !== "main",
);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<script is:inline>
  // Se ejecuta antes de pintar para evitar el parpadeo claro→oscuro.
  (() => {
    const stored = localStorage.getItem("manual-theme");
    const theme =
      stored ||
      (window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light");
    document.documentElement.dataset.theme = theme;
    // Navegación sin recarga: el <html> de la página nueva llega sin tema;
    // se le pasa el actual antes del intercambio para que no parpadee.
    document.addEventListener("astro:before-swap", (event) => {
      event.newDocument.documentElement.dataset.theme =
        document.documentElement.dataset.theme;
    });
  })();
</script>
<meta name="description" content={description} />
{preventIndexing && <meta name="robots" content="noindex, nofollow" />}
<link rel="icon" type="image/svg+xml" href="/brand/aturnos-symbol.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
  rel="stylesheet"
/>
<title>{title}</title>
{clientRouter && <ClientRouter />}
