---
// Filtro del manual por rol (selector de la cabecera, #profile-picker).
// Oculta tarjetas, entradas del menú lateral y el contenido de artículos que
// el rol elegido no puede ver. Va al final del <body> porque recorre toda la
// página; es inline para aplicarse antes de pintar y evitar parpadeos.
---

<script is:inline>
  const picker = document.querySelector("#profile-picker");
  const profileLoader = document.querySelector("#profile-loader");

  // Jerarquía de roles: cada rol ve lo suyo y lo de los roles inferiores.
  // Trabajador = 1 (solo lo de trabajador), Administrador = 2 (trabajador +
  // administrador), RRHH = 3 (todo). Cualquier otro rol de un artículo
  // (Nóminas, Desarrollador API…) se trata como nivel RRHH.
  const ROLE_RANK = { Trabajador: 1, Administrador: 2, RRHH: 3 };
  const canSee = (profile, rawRoles) => {
    if (!profile || profile === "general") return true;
    const roles = (rawRoles || "").split("|").filter(Boolean);
    if (roles.length === 0) return true;
    const lowest = Math.min(...roles.map((r) => ROLE_RANK[r] ?? 3));
    return lowest <= (ROLE_RANK[profile] ?? 3);
  };

  const applyProfileFilter = (profile) => {
    document.querySelectorAll("[data-profile-card]").forEach((card) => {
      card.hidden = !canSee(profile, card.dataset.profiles);
    });

    document
      .querySelectorAll("[data-module-profile-counts]")
      .forEach((card) => {
        const counts = JSON.parse(card.dataset.moduleProfileCounts || "{}");
        const count =
          profile === "general"
            ? Number(card.dataset.totalCount || 0)
            : Number(counts[profile] || 0);
        card.hidden = profile !== "general" && count === 0;
        const label = card.querySelector("[data-module-count]");
        if (label)
          label.textContent = `${count} ${count === 1 ? "artículo" : "artículos"}`;
      });

    const visibleCards = [
      ...document.querySelectorAll(
        "[data-profile-list] [data-profile-card]:not([hidden])",
      ),
    ];
    document
      .querySelectorAll("[data-profile-visible-count]")
      .forEach((label) => {
        label.textContent = String(visibleCards.length);
      });
    const areas = new Set(
      visibleCards.map((card) => card.dataset.submodule).filter(Boolean),
    );
    document
      .querySelectorAll("[data-profile-area-count]")
      .forEach((label) => {
        label.textContent = String(areas.size);
      });
    document.querySelectorAll("[data-profile-empty]").forEach((message) => {
      message.hidden = visibleCards.length !== 0;
    });

    // Menú lateral: lo que no puede ver el rol se OCULTA (artículos, grupos
    // que se quedan sin nada y categorías enteras).
    const nav = document.querySelector("[data-site-nav]");
    if (nav) {
      nav
        .querySelectorAll("li[hidden]")
        .forEach((li) => (li.hidden = false));
      nav.querySelectorAll("a[data-profiles]").forEach((a) => {
        const ok = canSee(profile, a.dataset.profiles);
        if (a.classList.contains("guide-nav-link")) {
          const li = a.closest("li");
          if (li) li.hidden = !ok;
        } else {
          a.toggleAttribute("data-role-hidden", !ok);
        }
      });
      // ¿El enlace está realmente visible dentro de `scope`?
      const shown = (el, scope) => {
        for (let e = el; e && e !== scope; e = e.parentElement)
          if (e.hidden) return false;
        return !el.hasAttribute("data-role-hidden");
      };
      [...nav.querySelectorAll("li.guide-nav-node")]
        .reverse()
        .forEach((node) => {
          const leaf = [...node.querySelectorAll("a.guide-nav-link")].some(
            (a) => shown(a, node),
          );
          const head = node.querySelector(
            ":scope > a.guide-nav-head-link[data-profiles]",
          );
          const headOk = Boolean(
            head &&
            head.dataset.profiles &&
            !head.hasAttribute("data-role-hidden"),
          );
          node.hidden = !(leaf || headOk);
        });
      const pills = [
        ...nav.querySelectorAll("a.site-nav-pill[data-section]"),
      ];
      pills.forEach((pill) => {
        const panel = nav.querySelector(
          `[data-panel="${pill.dataset.section}"]`,
        );
        if (!panel || !panel.querySelector("[data-profiles]")) {
          pill.hidden = false;
          return;
        }
        const any = [
          ...panel.querySelectorAll(
            "a.guide-nav-link, a.guide-nav-head-link[data-profiles]",
          ),
        ].some((a) => shown(a, panel));
        pill.hidden = !any;
      });
      // Si la categoría activa se quedó sin contenido, pasa a la primera visible.
      const active = pills.find((p) => p.classList.contains("is-active"));
      const first = pills.find((p) => !p.hidden);
      if (active && active.hidden && first) {
        pills.forEach((p) => {
          const on = p === first;
          p.classList.toggle("is-active", on);
          p.setAttribute("aria-selected", String(on));
        });
        nav.querySelectorAll("[data-panel]").forEach((panel) => {
          panel.hidden = panel.dataset.panel !== first.dataset.section;
        });
      }
    }

    // Artículo abierto: si su rol no lo ve, se oculta el contenido y se
    // muestra el aviso.
    const gate = document.querySelector("[data-profile-gate]");
    const notice = document.querySelector("[data-profile-unavailable]");
    if (gate && notice) {
      const ok = canSee(profile, gate.dataset.profiles);
      gate.hidden = !ok;
      notice.hidden = ok;
    }
  };

  const storedProfile = localStorage.getItem("manual-profile") || "general";
  document.documentElement.dataset.profile = storedProfile;
  if (picker) picker.value = storedProfile;
  applyProfileFilter(storedProfile);

  if (picker) {
    picker.addEventListener("change", () => {
      profileLoader.hidden = false;
      profileLoader.dataset.busy = "profile";
      localStorage.setItem("manual-profile", picker.value);
      document.documentElement.dataset.profile = picker.value;
      applyProfileFilter(picker.value);
      window.dispatchEvent(
        new CustomEvent("manual-profile-change", {
          detail: { profile: picker.value },
        }),
      );
      window.setTimeout(() => {
        if (profileLoader.dataset.busy === "profile") {
          delete profileLoader.dataset.busy;
          profileLoader.hidden = true;
        }
      }, 450);
    });
  }
</script>
