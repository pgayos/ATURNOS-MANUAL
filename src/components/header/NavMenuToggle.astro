---
// Botón hamburguesa (solo visible en móvil) que abre el menú lateral #site-nav.
// La apertura la gestiona el script de BaseLayout (#nav-menu-toggle).
---

<button
  class="nav-menu-toggle"
  id="nav-menu-toggle"
  type="button"
  aria-label="Abrir menú de navegación"
  aria-controls="site-nav"
  aria-expanded="false"
>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path
      d="M4 6h16M4 12h16M4 18h16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
    ></path>
  </svg>
</button>
