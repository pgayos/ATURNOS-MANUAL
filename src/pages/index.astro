---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuickLinks from "../components/home/QuickLinks.astro";

const quickLinks = [
  {
    name: "Cómo empezar en aTurnos",
    description:
      "Guía de implantación: primeros pasos para configurar el equipo y empezar a planificar.",
    icon: "◉",
    badge: "Guía inicial",
    cta: "Ver guía inicial",
    href: "/manual/empezar-en-aturnos/",
  },
  {
    name: "Documentación",
    description:
      "Explora todos los módulos del manual de aTurnos, organizados por área.",
    icon: "▤",
    badge: "10+ módulos",
    cta: "Explorar manual íntegro",
    href: "/manual/",
  },
  {
    name: "App móvil",
    description: "Uso de aTurnos desde dispositivos móviles y fichaje.",
    icon: "▣",
    badge: "iOS & Android",
    cta: "Descarga y manual app",
    href: "/manual/app-movil/",
  },
  {
    name: "Gestión de proyectos",
    description:
      "Conoce cómo nuestros consultores trabajan en adaptar aTurnos para ti.",
    icon: "▦",
    badge: "Consultoría",
    cta: "Fases de implantación",
    href: "/manual/gestion-de-proyectos/",
  },
  {
    name: "Integración con Biostar",
    description:
      "Conecta aTurnos con tu sistema de control de accesos Biostar.",
    icon: "⇄",
    badge: "Hardware",
    cta: "Configurar terminales",
    href: "/manual/integracion-biostar/",
  },
  {
    name: "Glosario",
    description: "Consulta el significado de los términos usados en aTurnos.",
    icon: "◇",
    badge: "A-Z Glosario",
    cta: "Ver definiciones",
    href: "/manual/glosario/",
  },
  {
    name: "ApiRest",
    description: "Documentación técnica de la API REST de aTurnos.",
    icon: "⌘",
    badge: "Desarrolladores",
    cta: "Ver documentación de la API",
    href: "https://api.aturnos.com/",
    external: true,
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-content">
      <span class="eyebrow">Centro de ayuda aTurnos</span>
      <h1>
        Encuentra respuestas.
        <br />
        <span>Trabaja con confianza.</span>
      </h1>
      <p class="lead">
        Guías verificadas, organizadas por módulos y preparadas para ayudarte
        también mediante IA.
      </p>
      <form class="hero-search" action="/buscar/">
        <input
          name="q"
          aria-label="Buscar en el manual"
          placeholder="¿Qué necesitas hacer en aTurnos?"
        />
        <button class="button">Buscar</button>
      </form>
    </div>
  </section>
  <QuickLinks
    eyebrow="Explora el producto"
    title="Accesos directos"
    links={quickLinks}
  />
</BaseLayout>
