---
import BaseLayout from "../layouts/BaseLayout.astro";
import ModuleShowcase from "../components/home/ModuleShowcase.astro";
import AturnosBanner from "../components/home/AturnosBanner.astro";
import StatusBar from "../components/home/StatusBar.astro";

const popularTags = [
  { icon: "◴", label: "Control Horario", href: "/manual/control-horario/" },
  { icon: "▦", label: "Cuadrante", href: "/buscar/?q=cuadrante" },
  { icon: "☼", label: "Vacaciones", href: "/buscar/?q=vacaciones" },
  { icon: "€", label: "Nóminas", href: "/manual/costes-y-nominas/" },
  { icon: "▣", label: "App Móvil", href: "/manual/app-movil/" },
  { icon: "⇄", label: "Biostar", href: "/manual/integracion-biostar/" },
];

const modules = [
  {
    name: "Cómo empezar en aTurnos",
    description:
      "Guía completa de adopción: primeros pasos para configurar el equipo y empezar a planificar.",
    icon: "◉",
    badge: "Guía inicial",
    recommended: true,
    featured: true,
    readingTime: "Lectura estimada: 10 minutos",
    steps: [
      {
        title: "Crear equipo",
        description: "Carga de trabajadores y convenios",
      },
      {
        title: "Planificar cuadrante",
        description: "Patrones, rotaciones y turnos",
      },
      {
        title: "Fichar y auditar",
        description: "Control horario y absentismos",
      },
    ],
    cta: "Comenzar ahora el onboarding",
    href: "/manual/empezar-en-aturnos/",
  },
  {
    name: "Documentación completa",
    description:
      "Catálogo íntegro con todos los módulos: patrones, absentismos, estadísticas, horas y exportaciones.",
    icon: "▤",
    badge: "700+ artículos",
    cta: "Explorar catálogo",
    href: "/manual/",
  },
  {
    name: "App móvil",
    description:
      "Fichaje con geolocalización, petición de cambios de turno entre compañeros y consulta de saldo de horas.",
    icon: "▣",
    badge: "iOS & Android",
    cta: "Manual app móvil",
    href: "/manual/app-movil/",
  },
  {
    name: "Gestión de proyectos e implantación",
    description:
      "Metodología de puesta en marcha, análisis previo, pilotos y acompañamiento con un consultor dedicado.",
    icon: "▦",
    badge: "Consultoría",
    cta: "Fases de implantación",
    href: "/manual/gestion-de-proyectos/",
  },
  {
    name: "Control horario & Biostar",
    description:
      "Conexión con terminales biométricos Biostar, tótems de entrada y fichaje por tablet con Wall App.",
    icon: "⇄",
    badge: "Integración y Hardware",
    cta: "Configuración y agentes",
    href: "/manual/integracion-biostar/",
  },
  // {
  //   name: "Glosario & API REST",
  //   description:
  //     "Definición formal de términos laborales, conceptos salariales y documentación técnica para desarrolladores.",
  //   icon: "◇",
  //   badge: "Técnico & RRHH",
  //   links: [
  //     { label: "Glosario", href: "/manual/glosario/" },
  //     {
  //       label: "Swagger API",
  //       href: "https://api.aturnos.com/",
  //       external: true,
  //     },
  //   ],
  // },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-content">
      <span class="hero-badge">
        <span class="hero-badge-dot" aria-hidden="true"></span>
        Centro de ayuda aTurnosDocs
      </span>
      <h1>
        aTurnosDocs
        <br />
        <span>Trabaja con confianza.</span>
      </h1>
      <p class="lead">
        Guías oficiales paso a paso, manuales interactivos y asistencia técnica
        para optimizar cuadrantes, fichajes y normativas de tu empresa.
      </p>
      <div
        class="hero-search-backdrop"
        id="hero-search-backdrop"
        aria-hidden="true"
      ></div>
      <div class="hero-search-wrap">
        <form
          class="hero-search"
          id="hero-search"
          action="/buscar/"
          autocomplete="off"
        >
          <span class="hero-search-icon" aria-hidden="true">
            ⌕
          </span>
          <input
            id="hero-search-input"
            name="q"
            type="search"
            autocomplete="off"
            aria-label="Buscar en el manual"
            aria-expanded="false"
            aria-controls="hero-search-suggestions"
            role="combobox"
            aria-autocomplete="list"
            placeholder="¿Qué buscas? (ej. cuadrante, fichaje biométrico, vacaciones…)"
          />
          <button class="button">
            Buscar
            <span aria-hidden="true">→</span>
          </button>
        </form>
        <div
          class="hero-search-suggestions"
          id="hero-search-suggestions"
          role="listbox"
          hidden
        ></div>
      </div>
      <div class="hero-tags">
        <span class="hero-tags-label">Populares:</span>
        {popularTags.map((tag) => (
          <a class="hero-tag" href={tag.href}>
            <span aria-hidden="true">{tag.icon}</span>
            {tag.label}
          </a>
        ))}
      </div>
    </div>
  </section>
  <ModuleShowcase
    eyebrow="▦ Módulos principales"
    title="Explora la documentación por sección"
    syncLabel="Índice sincronizado"
    modules={modules}
  />
  <AturnosBanner />
  <StatusBar />
  <script>
    import { initSearchWidget } from "../lib/searchWidget.js";
    initSearchWidget({
      form: document.querySelector("#hero-search"),
      input: document.querySelector("#hero-search-input"),
      suggestions: document.querySelector("#hero-search-suggestions"),
      backdrop: document.querySelector("#hero-search-backdrop"),
    });
  </script>
</BaseLayout>
