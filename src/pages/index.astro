---
import BaseLayout from "../layouts/BaseLayout.astro";
import ModuleGrid from "../components/home/ModuleGrid.astro";
import FeaturedArticles from "../components/home/FeaturedArticles.astro";
import { getCollection } from "astro:content";
const allArticles = await getCollection("manual");
const articles = allArticles
  .filter(({ data }) => data.featured)
  .sort(
    (a, b) =>
      a.data.order - b.data.order ||
      a.data.title.localeCompare(b.data.title, "es"),
  );
const moduleDescriptions: Record<string, string> = {
  "App móvil": "Uso de aTurnos desde dispositivos móviles y fichaje.",
  "Cita previa": "Servicios, reservas y gestión de citas.",
  "Configuración y cuenta": "Ajustes generales, permisos, jornadas y cuenta.",
  "Control horario": "Fichajes, validaciones, informes y configuración.",
  "Costes y nóminas": "Costes, conceptos, plantillas y exportación de nóminas.",
  Documentos: "Documentación, importaciones y gestión de archivos.",
  General: "Conceptos generales y funcionamiento transversal de aTurnos.",
  "Gestión de personal": "Trabajadores, contratos, permisos y datos laborales.",
  "Integraciones y API": "Integraciones, conectores y uso de la API.",
  "Peticiones y cambios": "Solicitudes, cambios y circuitos de aprobación.",
  Planificación: "Cuadrantes, turnos, patrones, vacaciones y coberturas.",
  "Recursos y partes": "Recursos, partes de trabajo y asignaciones.",
  Tareas: "Creación, asignación y seguimiento de tareas.",
};
const moduleIcons: Record<string, string> = {
  "App móvil": "▣",
  "Cita previa": "◷",
  "Configuración y cuenta": "⚙",
  "Control horario": "◴",
  "Costes y nóminas": "€",
  Documentos: "▤",
  General: "◎",
  "Gestión de personal": "♙",
  "Integraciones y API": "⌘",
  "Peticiones y cambios": "⇄",
  Planificación: "▦",
  "Recursos y partes": "◇",
  Tareas: "✓",
};
function buildModuleCards(source: typeof allArticles) {
  return [
    ...new Map(
      source.map((article) => {
        const slug = article.id.split("/").slice(0, -1).join("/");
        return [article.data.module, { name: article.data.module, slug }];
      }),
    ).values(),
  ]
    .map((module) => {
      const moduleArticles = source.filter(
        (a) => a.data.module === module.name,
      );
      const profileCounts = Object.fromEntries(
        ["Trabajador", "Planificador", "Administrador", "RRHH"].map(
          (profile) => [
            profile,
            moduleArticles.filter((article) =>
              article.data.audience.some((item) => item.role === profile),
            ).length,
          ],
        ),
      );
      return { ...module, count: moduleArticles.length, profileCounts };
    })
    .sort((a, b) => a.name.localeCompare(b.name, "es"));
}

const webArticles = allArticles.filter((a) => a.data.platforms.includes("web"));
const appArticles = allArticles.filter((a) => a.data.platforms.includes("app"));

const modules = buildModuleCards(webArticles).filter(
  (module) => module.name !== "Piloto",
);
const appModules = buildModuleCards(appArticles);

const visibleModuleNames = [
  // "App móvil",
  "Planificación",
  "Control horario",
  // "Cita previa",
  "Configuración y cuenta",
  "Costes y nóminas",
  "Documentos",
  "General",
  "Gestión de personal",
  "Integraciones y API",
  "Peticiones y cambios",
  "Recursos y partes",
  "Tareas",
  "Pruebas",
];

const visibleAppModuleNames = ["Control horario", "Pruebas", "App móvil"];
const visibleModules = visibleModuleNames
  .map((name) => modules.find((module) => module.name === name))
  .filter((module): module is (typeof modules)[number] => module !== undefined);

const visibleAppModules = visibleAppModuleNames
  .map((name) => appModules.find((appModule) => appModule.name === name))
  .filter((appModule) => appModule !== undefined);
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-content">
      <span class="eyebrow">Centro de ayuda aTurnos</span><h1>
        Encuentra respuestas.<br /><span>Trabaja con confianza.</span>
      </h1><p class="lead">
        Guías verificadas, organizadas por módulos y preparadas para ayudarte
        también mediante IA.
      </p><form class="hero-search" action="/buscar/">
        <input
          name="q"
          aria-label="Buscar en el manual"
          placeholder="¿Qué necesitas hacer en aTurnos?"
        /><button class="button">Buscar</button>
      </form>
    </div>
  </section>
  <ModuleGrid
    id="modulos"
    eyebrow="Explora el producto"
    title="Módulos"
    modules={visibleModules}
    icons={moduleIcons}
    descriptions={moduleDescriptions}
  />
  <ModuleGrid
    eyebrow="Explora nuestra App"
    title="App Móvil"
    modules={visibleAppModules}
    icons={moduleIcons}
    descriptions={moduleDescriptions}
  />
  <FeaturedArticles
    eyebrow="Selección"
    title="Contenido destacado"
    articles={articles}
  />
</BaseLayout>
