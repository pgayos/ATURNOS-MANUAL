---
import { getCollection } from 'astro:content';
import { buildGuideNav, isGuideModule, topLevelModuleSlugOf } from '../../../lib/guideNav';

// Todo módulo (salvo Glosario) usa navegación de sidebar: no hay página de
// cards de módulo/submódulo/tema, así que entrar a /manual/<módulo>/ salta
// directo al primer artículo, que ya trae el índice completo en su lateral.
export async function getStaticPaths() {
  const entries = await getCollection('manual');

  // Por módulo "contenedor" (primer segmento de carpeta), no por
  // "todo menos el último": si no, un módulo con subcarpetas como
  // app-movil/<módulo-web>/ generaría una página de redirección por cada
  // subcarpeta en vez de una sola para /manual/app-movil/.
  const moduleSlugs = new Set(
    entries
      .map((entry) => topLevelModuleSlugOf(entry.id))
      .filter((moduleSlug) => isGuideModule(moduleSlug)),
  );

  return [...moduleSlugs].map((moduleSlug) => {
    const { firstArticleId } = buildGuideNav(entries, moduleSlug);
    return {
      params: { module: moduleSlug },
      props: { target: `/manual/${firstArticleId}/` },
    };
  });
}

const { target } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Redirigiendo…</title>
  </head>
  <body>
    <p>Redirigiendo a <a href={target}>{target}</a>…</p>
    <script is:inline set:html={`location.replace(${JSON.stringify(target)});`} />
  </body>
</html>
