---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../components/manual/ArticleLayout.astro";
import { routeIdOf } from "../../lib/guideNav";

export async function getStaticPaths() {
  const entries = await getCollection("manual");
  return entries.map((entry) => ({
    params: { id: routeIdOf(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} headings={headings}><Content /></ArticleLayout>
