---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { firstLetter } from '../../../lib/slug';

// Los términos de glosario viven físicamente en src/content/manual/glosario/
// (module: Glosario), así que sus URLs son /manual/glosario/<término>/.
const entries = await getCollection('manual', (entry) => entry.data.module === 'Glosario');

// Un mismo artículo puede tener más de un nombre en el glosario original (ver
// `synonyms`) — cada nombre aparece como su propia entrada en el índice A-Z,
// todas apuntando al mismo artículo.
const displayEntries = entries.flatMap((entry) => [
  { text: entry.data.title, href: `/manual/${entry.id}/` },
  ...entry.data.synonyms.map((synonym) => ({ text: synonym, href: `/manual/${entry.id}/` }))
]);
const sorted = displayEntries.sort((a, b) => a.text.localeCompare(b.text, 'es'));

const groups: { letter: string; terms: typeof sorted }[] = [];
for (const term of sorted) {
  const letter = firstLetter(term.text);
  const lastGroup = groups[groups.length - 1];
  if (lastGroup && lastGroup.letter === letter) {
    lastGroup.terms.push(term);
  } else {
    groups.push({ letter, terms: [term] });
  }
}
---

<BaseLayout title="Glosario · Manual de aTurnos" description="Todos los términos del glosario de aTurnos, ordenados alfabéticamente.">
  <div class="container breadcrumbs"><a href="/">Inicio</a> / Glosario</div>
  <section class="hero"><div class="container"><span class="eyebrow">Módulo</span><h1>Glosario</h1><p class="lead">Consulta los {sorted.length} términos del glosario de aTurnos, ordenados de la A a la Z.</p></div></section>
  <section class="section container">
    <div class="glossary-list">
      {groups.map(group => (
        <Fragment>
          <span class="glossary-letter">{group.letter}</span>
          <ul class="glossary-terms">
            {group.terms.map(term => <li><a href={term.href}>{term.text}</a></li>)}
          </ul>
        </Fragment>
      ))}
    </div>
  </section>
</BaseLayout>
