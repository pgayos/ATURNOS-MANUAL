---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  moduleName: string;
  articles: CollectionEntry<'manual'>[];
}

export async function getStaticPaths() {
  const entries = await getCollection('manual');
  const groups = new Map<string, CollectionEntry<'manual'>[]>();

  for (const entry of entries) {
    const moduleSlug = entry.id.split('/')[0];
    const group = groups.get(moduleSlug) ?? [];
    group.push(entry);
    groups.set(moduleSlug, group);
  }

  return [...groups.entries()].map(([module, articles]) => ({
    params: { module },
    props: {
      moduleName: articles[0].data.module,
      articles: articles.sort((a, b) => a.data.title.localeCompare(b.data.title, 'es'))
    }
  }));
}

const { moduleName, articles } = Astro.props;
const submodules = [...new Set(articles.map(article => article.data.submodule))];
---
<BaseLayout title={`${moduleName} · Manual de aTurnos`} description={`Guías y documentación del módulo ${moduleName} de aTurnos.`}>
  <section class="hero"><div class="container"><span class="eyebrow">Módulo</span><h1>{moduleName}</h1><p class="lead">Consulta <span data-profile-visible-count>{articles.length}</span> artículos organizados en <span data-profile-area-count>{submodules.length}</span> áreas para el perfil seleccionado.</p></div></section>
  <section class="section container">
    <div class="card-grid" data-profile-list>{articles.map(article => <a class="card" data-profile-card data-profiles={article.data.audience.map(item => item.role).join('|')} data-submodule={article.data.submodule} href={`/manual/${article.id}/`}><span class="badge">{article.data.submodule}</span><h3>{article.data.title}</h3><p>{article.data.description}</p></a>)}</div>
    <p class="profile-empty" data-profile-empty hidden>No hay artículos de este módulo asignados al perfil seleccionado.</p>
  </section>
</BaseLayout>
