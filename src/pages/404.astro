---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada · Manual de aTurnos" description="La página solicitada no existe o ha cambiado de dirección.">
  <main class="container search-page">
    <span class="eyebrow">Error 404</span>
    <h1>No encontramos esta página</h1>
    <p class="lead">Es posible que el contenido haya cambiado de dirección. Puedes buscarlo o volver a explorar los módulos del manual.</p>
    <div class="hero-search">
      <a class="button" href="/buscar/">Buscar en el manual</a>
      <a class="button button-secondary" href="/">Volver al inicio</a>
    </div>
  </main>
</BaseLayout>
